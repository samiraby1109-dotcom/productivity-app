# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Session ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
SESSION_SECRET=your-32-char-secret-key-here-replace-me

# ─── Cron ─────────────────────────────────────────────────────────────────────
CRON_SECRET=your-cron-secret-here

# ─── 211 Resources API ────────────────────────────────────────────────────────
# Enables nationwide DV resource lookup via the 211 National Data Platform.
# Register free at: https://apiportal.211.org  (~5 min, no cost)
# Without this key the app falls back to the hardcoded KC-area shelter list.
RESOURCES_API_KEY=

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Optional. When absent, all email sending is silently skipped.
# Also skipped when DEV_MODE=true.
# Get a key at: https://resend.com
# IMPORTANT: sender domain must be verified in Resend before sending.
# Use a NEUTRAL sender name — never reference the app's true purpose.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=BelleMeadow Wellness <noreply@yourdomain.com>

# ─── Environment ──────────────────────────────────────────────────────────────
NODE_ENV=development
# Set to "true" to enable dev mode (disables email verification, enables demo seed)
DEV_MODE=true
